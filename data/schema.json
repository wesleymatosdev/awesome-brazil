{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hub de iniciativas — esquema de dados",
  "description": "Cada iniciativa listada no hub. Envie novas entradas editando este arquivo via PR.",
  "type": "object",
  "required": ["version", "categories", "initiatives"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 2 }
        },
        "additionalProperties": false
      }
    },
    "initiatives": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "url", "category"],
        "properties": {
          "name": { "type": "string", "minLength": 2, "maxLength": 80 },
          "description": { "type": "string", "minLength": 10, "maxLength": 280 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "repo": { "type": "string", "pattern": "^https://" },
          "category": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "tags": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z0-9à-ú\\s-]+$", "minLength": 2 },
            "maxItems": 8
          },
          "added": { "type": "string", "format": "date" }
        },
        "additionalProperties": false
      }
    }
  }
}
